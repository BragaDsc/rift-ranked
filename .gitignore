# deps
node_modules/
# build output (regenerado por `npm run build` / push-backend.sh)
backend/dist/
# verificação de build (gerado)
backend/dist-verify/
# zip da extensão (artefato de build)
extension/dist/
# pasta extraída pra instalar (artefato)
extension/unpacked/
# segredos / ambiente
*.env
.env
.env.*
!.env.example
# chaves
*deploy_key*
*.pem
.secrets/
# config local de deploy (dados do servidor — fica só no seu PC)
scripts/deploy.local.env
!scripts/deploy.local.env.example
# OS / editor
.DS_Store
Thumbs.db
*.log
# artefatos locais
*.tmp
debug-frames.json

# Chrome Web Store build artifact
extension/rift-ranked-chrome-*.zip
