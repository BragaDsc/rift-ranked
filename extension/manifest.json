{
  "manifest_version": 3,
  "name": "Rift Ranked",
  "version": "0.3.33",
  "description": "Ranqueado por MMR (Glicko-2) para o RiftAtlas: fila, pareamento e orquestração de salas (Md1 e Md3).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://play.riftatlas.com/*",
    "https://app.megacards.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://play.riftatlas.com/*"],
      "js": ["dist/inpage.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://play.riftatlas.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ranked@riftatlas",
      "strict_min_version": "128.0"
    }
  }
}
