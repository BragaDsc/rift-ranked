# Copie para .env e preencha. NUNCA comite o .env real.
PORT=4100
# String de conexão do PostgreSQL (o deploy.sh gera uma senha aleatória em produção)
DATABASE_URL=postgresql://ranked:TROQUE_A_SENHA@127.0.0.1:5432/riftatlas_ranked
# Token do endpoint de administração (gere com: openssl rand -hex 24)
ADMIN_TOKEN=TROQUE_POR_UM_TOKEN_ALEATORIO
# (Opcional) Webhook para alerta ativo de quebra de auth (ex.: Discord).
# Se o RiftAtlas mudar o Clerk/selectors e a auth passar a falhar em massa,
# o servidor avisa aqui automaticamente. Deixe vazio para desativar.
# ALERT_WEBHOOK=https://discord.com/api/webhooks/xxxx/yyyy
