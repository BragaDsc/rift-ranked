# Config LOCAL de deploy. Copie para scripts/deploy.local.env e preencha com os
# dados do SEU servidor. O push-backend.sh e o deploy-ext.sh carregam este arquivo
# automaticamente, se existir.
#
# Este .example é versionado; o deploy.local.env real NÃO é (está no .gitignore).

# Destino SSH do deploy (usuário@host):
export RANKED_HOST=root@SEU_SERVIDOR

# Caminho da chave SSH de deploy (NUNCA versione a chave):
export RANKED_SSH_KEY="$HOME/.ssh/ranked_deploy_key"
